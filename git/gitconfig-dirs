# Personal-directory identity pins. Loaded LAST by the ~/.gitconfig stub so
# they beat a work overlay's default identity.
[includeIf "gitdir:~/projects/mystuff/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/rig/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/tools/"]
    path = ~/.gitconfig-personal
